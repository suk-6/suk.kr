{
	"name": "suk-kr",
	"version": "2.0.0",
	"private": true,
	"packageManager": "pnpm@11.5.0",
	"scripts": {
		"dev": "pnpm --parallel --filter @suk/web --filter @suk/api dev",
		"dev:web": "pnpm --filter @suk/web dev",
		"dev:api": "pnpm --filter @suk/api dev",
		"build": "pnpm --filter @suk/contracts build && pnpm --filter @suk/api build && pnpm --filter @suk/web build",
		"typecheck": "pnpm -r typecheck",
		"lint": "eslint . && prettier --check .",
		"format": "eslint . --fix && prettier --write .",
		"test": "pnpm --filter @suk/api test"
	},
	"devDependencies": {
		"eslint": "^9.39.5",
		"eslint-config-next": "16.2.12",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "3.9.6",
		"typescript": "^6.0.0"
	}
}
