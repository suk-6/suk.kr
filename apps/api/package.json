{
	"name": "@suk/api",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "npx wrangler dev",
		"build": "npx wrangler deploy --dry-run --outdir dist",
		"deploy": "npx wrangler deploy",
		"db:local": "npx wrangler d1 migrations apply suk-kr --local",
		"db:remote": "npx wrangler d1 migrations apply suk-kr --remote",
		"typecheck": "npx wrangler types --check && tsc --noEmit",
		"types": "npx wrangler types",
		"test": "vitest run"
	},
	"dependencies": {
		"@suk/contracts": "workspace:*",
		"hono": "latest",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "latest",
		"@types/node": "^26.1.2",
		"vitest": "latest",
		"wrangler": "latest"
	}
}
